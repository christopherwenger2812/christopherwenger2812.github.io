{
  "name": "Alltag",
  "short_name": "Alltag",
  "description": "Kalender, Aufgaben, Notizen, Einkauf, Rezepte, Verbrauch, Wetter, E-Mail und Passwörter – alles an einem Ort.",
  "lang": "de",
  "dir": "ltr",
  "start_url": "./index.html",
  "scope": "./",
  "id": "/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#faf9f7",
  "theme_color": "#faf9f7",
  "categories": [
    "productivity",
    "lifestyle",
    "utilities"
  ],
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Aufgabe hinzufügen",
      "short_name": "Aufgabe",
      "description": "Neue Aufgabe in Mein Tag",
      "url": "./index.html?aktion=aufgabe",
      "icons": [
        {
          "src": "shortcut-aufgabe.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Einkaufsliste",
      "short_name": "Einkauf",
      "description": "Einkaufsliste öffnen",
      "url": "./index.html?aktion=einkauf",
      "icons": [
        {
          "src": "shortcut-einkauf.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Ablesung eintragen",
      "short_name": "Ablesung",
      "description": "Zählerstand erfassen",
      "url": "./index.html?aktion=ablesung",
      "icons": [
        {
          "src": "shortcut-ablesung.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "share_target": {
    "action": "./index.html",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
